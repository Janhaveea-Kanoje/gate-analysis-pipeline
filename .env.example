# Copy this file to .env and fill in real values. Never commit .env.

# USDA FoodData Central — free key from https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=

# UK Companies House — free key from https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Anthropic API key — only needed once you wire in LLM-assisted extraction (src/extraction/)
ANTHROPIC_API_KEY=

# DSLD, FSA Regulated Products, FSA Food Alerts, and DDInter are all open/keyless — no entry needed.
